# LLM pool for the agent's injectable hypothesis port (OpenAI-compatible).
# Copy this file to `.env` and fill in your own token. `.env` is gitignored.
# The project runs fully WITHOUT these — the LLM is only used with `--use-llm`,
# and every code path falls back to a deterministic generator when unset.

API_KEY=sk-your-pool-token-here
BASE_URL=https://token.qianbaner.top          # "/v1" is appended automatically if missing
LLM_MODEL=claude-sonnet-5                     # 池子里稳且快；也可 gpt-5.6-terra / gpt-5.6-sol（推理档更慢）
LLM_TIMEOUT=90                                 # per-request seconds before falling back
